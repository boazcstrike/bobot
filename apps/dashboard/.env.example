DATABASE_URL="file:./prisma/dev.db"
MONGODB_URI=""
MONGODB_DB_NAME="bobot"
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI=""
GMAIL_REFRESH_TOKEN=""
RCBC_GMAIL_TARGET_EMAIL="your.email@gmail.com"
RCBC_GMAIL_USER_ID="me"
RCBC_GMAIL_QUERY="from:(rcbc) (\"statement of account\" OR soa) has:attachment"
RCBC_GMAIL_MAX_MESSAGES="200"
RCBC_GMAIL_MAX_ATTACHMENTS="300"
STATEMENTS_SYNC_SOURCE="gmail_api"
GITHUB_NOTES_REPO="boazcstrike/boazcstrike"
GITHUB_NOTES_LOCAL_REPO="/path/to/local/repo"
GITHUB_NOTES_FILE="github-repos.md"
GITHUB_NOTES_BRANCH="main"
GITHUB_TOKEN=""
PLAYWRIGHT_GMAIL_CONNECT_MODE="persistent"
PLAYWRIGHT_GMAIL_ACCOUNT_INDEX="1"
PLAYWRIGHT_GMAIL_CDP_ENDPOINT="http://127.0.0.1:9222"
PLAYWRIGHT_GMAIL_HEADLESS="false"
PLAYWRIGHT_GMAIL_BROWSER_CHANNEL="chrome"
PLAYWRIGHT_GMAIL_USER_DATA_DIR=""
PLAYWRIGHT_GMAIL_DOWNLOAD_DIR=""
PLAYWRIGHT_GMAIL_MAX_MESSAGES="200"
PLAYWRIGHT_GMAIL_MAX_ATTACHMENTS="300"
PLAYWRIGHT_GMAIL_DOWNLOAD_TIMEOUT_MS="15000"

# --- Binance spot trading bot -----------------------------------------------
# Testnet keys are free at https://testnet.binance.vision (GitHub login).
# Create them with spot trading enabled and withdrawals DISABLED.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Mainnet keys. Enable spot trading, disable withdrawals, and restrict the key
# to this machine's IP in the Binance API management page.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Live trading stays off until this is exactly "true", so a stray config write
# can never move the bot onto real funds on its own.
BINANCE_ALLOW_LIVE=false
